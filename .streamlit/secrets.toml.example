# Copy to .streamlit/secrets.toml for local use, or paste into the
# "Secrets" box in Streamlit Community Cloud (App settings -> Secrets).
# The real secrets.toml is git-ignored. NEVER commit a real key.
MODEL_API_KEY = ""

# Strongly recommended for any public deployment (paid calls!):
APP_ACCESS_CODE = ""

# Optional per-session limits (defaults: 20 take checks, 10 interpretations)
MAX_TAKE_CHECKS = 20
MAX_INTERPRETATIONS = 10
